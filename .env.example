# Babbel API Production Configuration
# Copy this file to .env and configure your values
# docker-compose.prod.yml passes every value in this file to the Babbel container
# See README.md for complete setup instructions

# Database Configuration
# mysql is the database container in docker-compose.prod.yml.
# The MySQL container uses the same user, password and database name.
# BABBEL_DB_HOST takes host or host:port. The port defaults to 3306.
# Generate a password: openssl rand -hex 32
BABBEL_DB_HOST=mysql
BABBEL_DB_PASSWORD=
# BABBEL_DB_USER=babbel
# BABBEL_DB_NAME=babbel
# BABBEL_DB_MAX_OPEN_CONNS=100
BABBEL_ENV=production

# Authentication Method
# Options: local, oidc, both
# - local: Username/password only
# - oidc: OAuth/OIDC only (Microsoft, Google, etc.)
# - both: Both local and OAuth login available
BABBEL_AUTH_METHOD=local

# Local authentication policy
# Passwords always require at least 8 characters; these options can make the
# policy stricter. Accounts are temporarily locked after repeated failures.
# BABBEL_AUTH_MIN_PASSWORD_LENGTH=8
# BABBEL_AUTH_REQUIRE_UPPERCASE=true
# BABBEL_AUTH_REQUIRE_LOWERCASE=true
# BABBEL_AUTH_REQUIRE_NUMBER=true
# BABBEL_AUTH_REQUIRE_SPECIAL=false
# BABBEL_AUTH_MAX_LOGIN_ATTEMPTS=5
# BABBEL_AUTH_LOCKOUT_MINUTES=15

# OAuth/OIDC Configuration (optional)
# Only set these when BABBEL_AUTH_METHOD is "oidc" or "both"
# BABBEL_OIDC_PROVIDER_URL=https://login.microsoftonline.com/YOUR-TENANT-ID/v2.0
# BABBEL_OIDC_CLIENT_ID=your-client-id-from-azure-ad
# BABBEL_OIDC_CLIENT_SECRET=your-client-secret-from-azure-ad
# BABBEL_OIDC_REDIRECT_URL=https://your-api-domain.com/api/v1/auth/oauth/callback

# Frontend Configuration (required for OAuth)
# URL where users will be redirected after OAuth login
# BABBEL_FRONTEND_URL=https://your-frontend-domain.com

# Timezone
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# CORS Configuration
# Comma-separated list of allowed origins for browser access
# Leave empty to disable CORS (API-only access, no browser access)
# Required if your frontend runs on a different domain than the API
# Examples:
# - Development: http://localhost:3000,http://localhost:5173
# - Production: https://your-frontend-domain.com
# - Multiple: https://app.domain.com,https://staging.domain.com
# - Should match BABBEL_FRONTEND_URL if using OAuth
BABBEL_ALLOWED_ORIGINS=

# Cookie Configuration (for cross-subdomain authentication)
# Set cookie domain to share cookies across subdomains
# Examples:
# - For *.zuidwest.cloud: .zuidwest.cloud (note the leading dot)
# - For single domain: leave empty
# - For localhost: leave empty
BABBEL_COOKIE_DOMAIN=

# Cookie SameSite attribute
# Options: strict, lax, none
# - Use "none" for cross-subdomain requests (requires HTTPS)
# - Use "lax" for same-site requests (default)
# - Use "strict" for maximum security (may break OAuth flows)
BABBEL_COOKIE_SAMESITE=lax

# Radio Automation Integration
# Enable public bulletin endpoint for radio automation systems
# Leave empty to disable the endpoint (returns 404)
# Generate a secure key: openssl rand -hex 32
# BABBEL_AUTOMATION_KEY=your-secure-api-key-here

# Text-to-Speech (ElevenLabs)
# Enable TTS by providing an API key from https://elevenlabs.io
# BABBEL_ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Operational e-mail notifications (optional)
# Babbel sends alert e-mails through Microsoft Graph with OAuth2 client
# credentials. The tool zwfm-aerontoolbox uses the same flow.
# Give the Azure app registration the application permission Mail.Send.
# Give admin consent to this permission.
# FROM_ADDRESS is the shared mailbox or user that sends the e-mails.
# To disable the e-mails, keep all values empty. If the configuration is
# not complete or not correct, Babbel does not start.
# BABBEL_NOTIFICATIONS_EMAIL_TENANT_ID=12345678-1234-1234-1234-123456789abc
# BABBEL_NOTIFICATIONS_EMAIL_CLIENT_ID=12345678-1234-1234-1234-123456789abc
# BABBEL_NOTIFICATIONS_EMAIL_CLIENT_SECRET=your-client-secret
# BABBEL_NOTIFICATIONS_EMAIL_FROM_ADDRESS=babbel@example.com
# BABBEL_NOTIFICATIONS_EMAIL_RECIPIENTS=admin@example.com,ops@example.com

# Bulletin File Cleanup
# How long to keep bulletin audio files before automatic deletion (default: 168h = 7 days)
# Database records are preserved as audit trail. Uses Go duration format (e.g., 72h, 168h, 720h)
# Must be greater than zero.
# BABBEL_BULLETIN_RETENTION=168h
